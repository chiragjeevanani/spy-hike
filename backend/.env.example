# Trekigo backend environment. Copy this file to `.env` and fill in real values.
# NEVER commit the real .env — it is gitignored.

# Node environment: development | production | test
NODE_ENV=development

# Port the API listens on
PORT=4000

# MongoDB Atlas connection string, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trekigo?retryWrites=true&w=majority
# Use a dedicated database name (e.g. trekigo for dev, trekigo_e2e for end-to-end runs).
MONGO_URI=

# Secret used to sign JWTs. Generate a long random string for production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
