# Find Your Trek backend environment. Copy this file to `.env` and fill in real values.
# NEVER commit the real .env — it is gitignored.

# Node environment: development | production | test
NODE_ENV=development

# Admin Credentials
ADMIN_EMAIL=admin_email
ADMIN_PASSWORD=admin_password

# Port the API listens on
PORT=4000

# MongoDB Atlas connection string, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/findyourtrek?retryWrites=true&w=majority
# Use a dedicated database name (e.g. findyourtrek for dev, findyourtrek_e2e for end-to-end runs).
MONGO_URI=

# Secret used to sign JWTs. Generate a long random string for production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional. Redis connection string for the public catalog response cache,
# e.g. redis://localhost:6379 or redis://:password@host:6379.
# Leave unset to use an in-process cache instead — the API works either way,
# but a multi-process PM2 deploy wants a shared Redis so all workers agree.
REDIS_URL=

# Comma-separated browser origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloudinary Credentials for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging credentials for admin broadcast push notifications
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Note: Format the private key on a single line with escaped newlines (\n), wrapped in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Maps API Key for reverse-geocoding service proxy
GOOGLE_MAPS_API_KEY=""


# ─── Payments (Razorpay) ──────────────────────────────────────────────────────
# Leave PAYMENT_MODE at 'arrival' (or leave the keys blank) to keep the
# Pay-on-Arrival flow — no gateway call is ever made and no credentials are
# needed. Set it to 'online' AND fill in the key pair to route checkout through
# Razorpay Checkout.
PAYMENT_MODE=arrival

# Dashboard → Account & Settings → API Keys. Test-mode keys start with
# rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks → Add New Webhook. This secret is one WE
# choose there; it is NOT the API key secret above, and the two sign different
# things. Register the endpoint as:
#   https://<your-api-host>/api/v1/webhooks/razorpay
# subscribed to: payment.captured, payment.failed, order.paid,
#                refund.processed, refund.failed
# Test and Live mode keep separate webhook configuration — add it to both.
RAZORPAY_WEBHOOK_SECRET=

# How long an unpaid booking holds its reserved seats before it is cancelled
# and the seats, coupon and loyalty voucher are handed back.
PAYMENT_PENDING_TTL_MINUTES=20
