# Find Your Trek backend environment. Copy this file to `.env` and fill in real values.
# NEVER commit the real .env — it is gitignored.

# Node environment: development | production | test
NODE_ENV=development

# Admin Credentials
ADMIN_EMAIL=admin_email
ADMIN_PASSWORD=admin_password

# Port the API listens on
PORT=4000

# MongoDB Atlas connection string, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/findyourtrek?retryWrites=true&w=majority
# Use a dedicated database name (e.g. findyourtrek for dev, findyourtrek_e2e for end-to-end runs).
MONGO_URI=

# Secret used to sign JWTs. Generate a long random string for production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional. Redis connection string for the public catalog response cache,
# e.g. redis://localhost:6379 or redis://:password@host:6379.
# Leave unset to use an in-process cache instead — the API works either way,
# but a multi-process PM2 deploy wants a shared Redis so all workers agree.
REDIS_URL=

# Comma-separated browser origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloudinary Credentials for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging credentials for admin broadcast push notifications
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Note: Format the private key on a single line with escaped newlines (\n), wrapped in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Maps API Key for reverse-geocoding service proxy
GOOGLE_MAPS_API_KEY=""


# ─── Payments (PayU) ──────────────────────────────────────────────────────────
# Leave PAYMENT_MODE at 'arrival' (or leave the key/salt blank) to keep the
# Pay-on-Arrival flow — no gateway call is ever made and no credentials are
# needed. Set it to 'online' AND fill in the key and salt to route checkout
# through PayU Hosted Checkout.
PAYMENT_MODE=arrival

# PayU Dashboard → Developers → API Keys (Merchant Key and Salt v1).
# The salt signs every request and response — keep it server-side only.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# 'test' for test.payu.in credentials, 'production' for live ones.
PAYU_ENV=test

# Public URLs PayU and the customer's browser are redirected through:
#   API_PUBLIC_URL — this backend's public origin. PayU posts the payment
#                    result (surl/furl) to <API_PUBLIC_URL>/api/v1/payments/payu/return
#   FRONTEND_URL   — the customer web app, where the browser lands afterwards.
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# PayU Dashboard → Developers → Webhooks. Create webhooks pointing at
#   https://<your-api-host>/api/v1/webhooks/payu
# for Payment "Successful" and "Failed" events, and for Refund events.
# Payment webhooks are authenticated by their hash; refund webhooks are
# re-checked against the PayU API before anything is recorded.

# How long an unpaid booking holds its reserved seats before it is cancelled
# and the seats, coupon and loyalty voucher are handed back.
PAYMENT_PENDING_TTL_MINUTES=20
