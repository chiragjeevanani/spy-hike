{
  "name": "findyourtrek-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find Your Trek backend API — Node.js + Express + MongoDB serving the customer, organizer, and admin apps.",
  "main": "src/server.js",
  "scripts": {
    "dev": "lsof -ti :4000 | xargs kill -9 2>/dev/null; tail -f /dev/null | nodemon --no-stdin --watch src src/server.js",
    "dev:memory": "node src/dev-memory-server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "razorpay": "^2.9.8",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "vitest": "^3.0.4"
  }
}
